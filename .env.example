# ─── COS (Cambio Open Services) ─────────────────────────────────────────────
# FHIR R4 base URL for the sandbox
COS_FHIR_BASE_URL=https://openservices.cambio.se/cos-api/fhir/r4

# OAuth 2.0 token endpoint
COS_TOKEN_URL=https://openservices.cambio.se/cos-api/oauth2/token

# Client credentials (from developer.openservices.cambio.se)
COS_CLIENT_ID=your-client-id
COS_CLIENT_SECRET=your-client-secret

# Optional scope override (leave blank to use default)
COS_SCOPE=

# ─── Banterop ────────────────────────────────────────────────────────────────
# Hosted instance or local (http://localhost:3000)
BANTEROP_URL=https://banterop.fhir.me

# Required to upload/modify published scenarios
BANTEROP_EDIT_TOKEN=

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Demo defaults ───────────────────────────────────────────────────────────
# Pre-created banterop room ID (run scripts/create-room.ts to generate one)
BANTEROP_ROOM_ID=

# Personnummer of the test patient in COS sandbox
DEFAULT_PERSONNUMMER=195001011234
