# ─── COS (Cambio Open Services) ─────────────────────────────────────────────
# From the COS Quick Start guide (developer.openservices.cambio.se)

# FHIR R4 base URL
COS_FHIR_BASE_URL=https://api.openservices.cambio.se/api/open/fhir

# OAuth 2.0 token endpoint (Keycloak, Basic auth)
COS_TOKEN_URL=https://api.openservices.cambio.se/auth/realms/COS/protocol/openid-connect/token

# Client ID and secret (used for Basic auth on the token endpoint)
COS_CLIENT_ID=your-client-id
COS_CLIENT_SECRET=your-client-secret

# API subscription key (Ocp-Apim-Subscription-Key — from your profile in the developer portal)
COS_API_KEY=your-api-key

# Scope (default is sufficient for sandbox)
COS_SCOPE=user/*.read user/*.write

# ─── Banterop ────────────────────────────────────────────────────────────────
# Hosted instance: https://banterop.fhir.me
# Local Docker (profile "local"): set automatically by docker compose
BANTEROP_URL=https://banterop.fhir.me

# Required to upload/modify published scenarios via API
BANTEROP_EDIT_TOKEN=

# LLM provider for local banterop (only needed for --profile local)
# BANTEROP_LLM_PROVIDER=google
# GOOGLE_API_KEY=your-google-key
# or:
# BANTEROP_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Demo defaults ───────────────────────────────────────────────────────────
# Room ID from banterop (set after creating a room in the UI)
BANTEROP_ROOM_ID=

# Personnummer of the test patient in COS sandbox
DEFAULT_PERSONNUMMER=195001011234
